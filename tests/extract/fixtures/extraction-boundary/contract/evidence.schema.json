{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groundx-studio-harness.internal/schemas/extraction-boundary/evidence.schema.json",
  "title": "Extraction Boundary Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "surface",
    "run_id",
    "workflow_plan_nodes",
    "planned_executions",
    "boundary_events",
    "provider_bodies",
    "provider_executions",
    "not_applicable",
    "lineage",
    "candidate_review",
    "interactive_approval",
    "live_certification"
  ],
  "properties": {
    "schema_version": {
      "const": "extraction_boundary_evidence_v1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "surface": {
      "enum": [
        "arcadia_legacy",
        "arcadia_v1",
        "generic_v1",
        "adp_v1",
        "current_repro"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_plan_nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workflow_plan_node"
      }
    },
    "planned_executions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/planned_execution"
      }
    },
    "boundary_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/boundary_event"
      }
    },
    "provider_bodies": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/sha256"
      },
      "additionalProperties": {
        "$ref": "#/$defs/provider_body"
      }
    },
    "provider_executions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provider_execution"
      }
    },
    "not_applicable": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/not_applicable"
      }
    },
    "lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/lineage"
      }
    },
    "candidate_review": {
      "$ref": "#/$defs/candidate_review"
    },
    "interactive_approval": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/interactive_approval"
        }
      ]
    },
    "live_certification": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/live_certification"
        }
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "workflow_plan_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "stage",
        "owner",
        "workflow_schema_hash"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "stage": {
          "$ref": "#/$defs/non_empty_string"
        },
        "owner": {
          "$ref": "#/$defs/non_empty_string"
        },
        "workflow_schema_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "planned_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_id",
        "node_id",
        "ordinal",
        "input_sha256"
      ],
      "properties": {
        "execution_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "node_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "input_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "boundary_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "stage",
        "owner_repo",
        "owner_service",
        "entrypoint",
        "input_sha256",
        "output_sha256",
        "artifact_path"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "stage": {
          "$ref": "#/$defs/non_empty_string"
        },
        "owner_repo": {
          "$ref": "#/$defs/non_empty_string"
        },
        "owner_service": {
          "$ref": "#/$defs/non_empty_string"
        },
        "entrypoint": {
          "$ref": "#/$defs/non_empty_string"
        },
        "input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "output_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_path": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "provider_body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "artifact_path"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_path": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "provider_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt",
        "request_body_sha256",
        "response_sha256",
        "status"
      ],
      "properties": {
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "request_body_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "response_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "enum": [
            "success",
            "error"
          ]
        }
      }
    },
    "provider_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_id",
        "stage",
        "attempts"
      ],
      "properties": {
        "execution_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "stage": {
          "$ref": "#/$defs/non_empty_string"
        },
        "attempts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/provider_attempt"
          }
        }
      }
    },
    "not_applicable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "reason",
        "proof"
      ],
      "properties": {
        "stage": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reason": {
          "enum": [
            "case_does_not_call_stage",
            "service_not_in_runtime_path",
            "terminal_before_stage",
            "optional_artifact_absent"
          ]
        },
        "proof": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "lineage_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_event_id",
        "to_event_id",
        "artifact_sha256"
      ],
      "properties": {
        "from_event_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "to_event_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "lineage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "edge"
          ],
          "properties": {
            "kind": {
              "const": "handoff"
            },
            "edge": {
              "$ref": "#/$defs/lineage_edge"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "edges",
            "complete"
          ],
          "properties": {
            "kind": {
              "enum": [
                "fan_out",
                "fan_in"
              ]
            },
            "edges": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/lineage_edge"
              }
            },
            "complete": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "event_id",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "terminal"
            },
            "event_id": {
              "$ref": "#/$defs/non_empty_string"
            },
            "reason": {
              "enum": [
                "success",
                "error"
              ]
            }
          }
        }
      ]
    },
    "candidate_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "candidate_sha256"
      ],
      "properties": {
        "status": {
          "enum": [
            "unreviewed",
            "approved",
            "rejected"
          ]
        },
        "candidate_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "interactive_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "approved_sha256",
        "approved_at"
      ],
      "properties": {
        "reviewer": {
          "$ref": "#/$defs/non_empty_string"
        },
        "approved_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "approved_at": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "live_certification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "api_base_url",
        "deployment_identity_sha256",
        "report_path"
      ],
      "properties": {
        "environment": {
          "$ref": "#/$defs/non_empty_string"
        },
        "api_base_url": {
          "$ref": "#/$defs/non_empty_string"
        },
        "deployment_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "report_path": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    }
  }
}
