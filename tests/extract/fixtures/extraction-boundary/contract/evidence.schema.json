{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groundx-studio-harness.internal/schemas/extraction-boundary/evidence.schema.json",
  "title": "Extraction Boundary Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "surface",
    "run_id",
    "workflow_plan_nodes",
    "planned_executions",
    "boundary_events",
    "provider_bodies",
    "provider_executions",
    "not_applicable",
    "lineage",
    "candidate_review",
    "interactive_approval",
    "live_certification"
  ],
  "properties": {
    "schema_version": {
      "const": "extraction_boundary_evidence_v1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "surface": {
      "enum": [
        "arcadia_legacy",
        "arcadia_v1",
        "generic_v1",
        "adp_v1",
        "current_repro"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_plan_nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workflow_plan_node"
      }
    },
    "planned_executions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/planned_execution"
      }
    },
    "boundary_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/boundary_event"
      }
    },
    "provider_bodies": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/sha256"
      },
      "additionalProperties": {
        "$ref": "#/$defs/provider_body"
      }
    },
    "provider_executions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provider_execution"
      }
    },
    "not_applicable": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/not_applicable"
      }
    },
    "blocked_boundaries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blocked_boundary"
      }
    },
    "lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/lineage"
      }
    },
    "candidate_review": {
      "$ref": "#/$defs/candidate_review"
    },
    "interactive_approval": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/interactive_approval"
        }
      ]
    },
    "live_certification": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/live_certification"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "blocked_boundaries"
        ],
        "properties": {
          "blocked_boundaries": {
            "minItems": 1
          }
        }
      },
      "then": {
        "properties": {
          "candidate_review": {
            "properties": {
              "status": {
                "enum": [
                  "unreviewed",
                  "rejected"
                ]
              }
            }
          },
          "interactive_approval": {
            "type": "null"
          },
          "live_certification": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "workflow_plan_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "stage",
        "owner",
        "workflow_schema_hash"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "stage": {
          "$ref": "#/$defs/non_empty_string"
        },
        "owner": {
          "$ref": "#/$defs/non_empty_string"
        },
        "workflow_schema_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "planned_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_id",
        "node_id",
        "ordinal",
        "input_sha256"
      ],
      "properties": {
        "execution_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "node_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "input_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "boundary_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "stage",
        "owner_repo",
        "owner_service",
        "entrypoint",
        "input_sha256",
        "output_sha256",
        "artifact_path"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "stage": {
          "$ref": "#/$defs/non_empty_string"
        },
        "owner_repo": {
          "$ref": "#/$defs/non_empty_string"
        },
        "owner_service": {
          "$ref": "#/$defs/non_empty_string"
        },
        "entrypoint": {
          "$ref": "#/$defs/non_empty_string"
        },
        "input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "output_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_path": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "provider_body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "artifact_path"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_path": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "provider_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt",
        "request_body_sha256",
        "response_sha256",
        "status"
      ],
      "properties": {
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "request_body_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "response_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "enum": [
            "success",
            "error"
          ]
        }
      }
    },
    "provider_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_id",
        "stage",
        "attempts"
      ],
      "properties": {
        "execution_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "stage": {
          "$ref": "#/$defs/non_empty_string"
        },
        "attempts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/provider_attempt"
          }
        }
      }
    },
    "not_applicable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "reason",
        "proof"
      ],
      "properties": {
        "stage": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reason": {
          "enum": [
            "case_does_not_call_stage",
            "service_not_in_runtime_path",
            "terminal_before_stage",
            "optional_artifact_absent"
          ]
        },
        "proof": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "blocked_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "boundary_id",
        "first_broken_boundary",
        "failing_evidence",
        "affected_case",
        "owning_red_regression"
      ],
      "properties": {
        "status": {
          "const": "blocked_by_known_red_boundary"
        },
        "boundary_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "first_broken_boundary": {
          "$ref": "#/$defs/first_broken_boundary"
        },
        "failing_evidence": {
          "$ref": "#/$defs/failing_evidence"
        },
        "affected_case": {
          "$ref": "#/$defs/non_empty_string"
        },
        "owning_red_regression": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "first_broken_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary_id",
        "stage",
        "owner_repo",
        "details"
      ],
      "properties": {
        "boundary_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "stage": {
          "$ref": "#/$defs/non_empty_string"
        },
        "owner_repo": {
          "$ref": "#/$defs/non_empty_string"
        },
        "details": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "failing_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_path",
        "sha256"
      ],
      "properties": {
        "artifact_path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "lineage_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_event_id",
        "to_event_id",
        "artifact_sha256"
      ],
      "properties": {
        "from_event_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "to_event_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "lineage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "edge"
          ],
          "properties": {
            "kind": {
              "const": "handoff"
            },
            "edge": {
              "$ref": "#/$defs/lineage_edge"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "edges",
            "complete"
          ],
          "properties": {
            "kind": {
              "enum": [
                "fan_out",
                "fan_in"
              ]
            },
            "edges": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/lineage_edge"
              }
            },
            "complete": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "event_id",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "terminal"
            },
            "event_id": {
              "$ref": "#/$defs/non_empty_string"
            },
            "reason": {
              "enum": [
                "success",
                "error"
              ]
            }
          }
        }
      ]
    },
    "candidate_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "candidate_sha256"
      ],
      "properties": {
        "status": {
          "enum": [
            "unreviewed",
            "approved",
            "rejected"
          ]
        },
        "candidate_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "interactive_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "approved_sha256",
        "approved_at"
      ],
      "properties": {
        "reviewer": {
          "$ref": "#/$defs/non_empty_string"
        },
        "approved_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "approved_at": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "live_certification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "api_base_url",
        "deployment_identity_sha256",
        "report_path"
      ],
      "properties": {
        "environment": {
          "$ref": "#/$defs/non_empty_string"
        },
        "api_base_url": {
          "$ref": "#/$defs/non_empty_string"
        },
        "deployment_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "report_path": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "live_certification_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "created_at",
        "repo_heads",
        "runner_commit",
        "report",
        "deployment_identity",
        "workflow_setup",
        "workflow_readback_manifest",
        "workflow_readbacks",
        "cdn_inputs",
        "trace_seal",
        "four_case_result",
        "local_verifier"
      ],
      "properties": {
        "schema_version": {
          "const": "extraction_live_certification_reference_v1"
        },
        "run_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "created_at": {
          "$ref": "#/$defs/non_empty_string"
        },
        "repo_heads": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "identity_key",
              "repository",
              "branch",
              "commit"
            ],
            "properties": {
              "identity_key": {
                "$ref": "#/$defs/non_empty_string"
              },
              "repository": {
                "$ref": "#/$defs/non_empty_string"
              },
              "branch": {
                "$ref": "#/$defs/non_empty_string"
              },
              "commit": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              }
            }
          }
        },
        "runner_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "report": {
          "$ref": "#/$defs/live_reference_file"
        },
        "deployment_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expected",
            "actual",
            "runtime_sha256"
          ],
          "properties": {
            "expected": {
              "$ref": "#/$defs/live_reference_file"
            },
            "actual": {
              "$ref": "#/$defs/live_reference_file"
            },
            "runtime_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "workflow_setup": {
          "$ref": "#/$defs/live_reference_file"
        },
        "workflow_readback_manifest": {
          "$ref": "#/$defs/live_reference_file"
        },
        "workflow_readbacks": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_id",
              "surface",
              "workflow_id",
              "metadata_version",
              "schema_hash",
              "content_sha256",
              "file"
            ],
            "properties": {
              "case_id": {
                "$ref": "#/$defs/non_empty_string"
              },
              "surface": {
                "$ref": "#/$defs/non_empty_string"
              },
              "workflow_id": {
                "$ref": "#/$defs/non_empty_string"
              },
              "metadata_version": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/non_empty_string"
                  },
                  {
                    "type": "integer",
                    "minimum": 0
                  }
                ]
              },
              "schema_hash": {
                "$ref": "#/$defs/sha256"
              },
              "content_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "file": {
                "$ref": "#/$defs/live_reference_file"
              }
            }
          }
        },
        "cdn_inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_id",
              "surface",
              "asset",
              "url",
              "sha256"
            ],
            "properties": {
              "case_id": {
                "$ref": "#/$defs/non_empty_string"
              },
              "surface": {
                "$ref": "#/$defs/non_empty_string"
              },
              "asset": {
                "$ref": "#/$defs/non_empty_string"
              },
              "url": {
                "$ref": "#/$defs/non_empty_string"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "trace_seal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes",
            "modified_at",
            "seal_sha256"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/non_empty_string"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "modified_at": {
              "$ref": "#/$defs/non_empty_string"
            },
            "seal_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "four_case_result": {
          "type": "object",
          "required": [
            "sha256",
            "summary",
            "cases"
          ],
          "properties": {
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "summary": {
              "type": "object"
            },
            "cases": {
              "type": "array",
              "minItems": 4
            }
          }
        },
        "local_verifier": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "checked_at",
            "checks"
          ],
          "properties": {
            "status": {
              "const": "passed"
            },
            "checked_at": {
              "$ref": "#/$defs/non_empty_string"
            },
            "checks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        }
      }
    },
    "live_reference_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes",
        "modified_at"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "modified_at": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    }
  }
}
